{
  "name": "@fanlia/pi-auto-continue",
  "version": "0.1.0",
  "description": "Hypothesis-driven value delivery loop for Pi: SWOT → OKR → story map → PDCA, with TDD checks and closure gates.",
  "type": "module",
  "license": "MIT",
  "author": "fanlia",
  "homepage": "https://github.com/fanlia/pi-auto-continue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanlia/pi-auto-continue.git"
  },
  "bugs": {
    "url": "https://github.com/fanlia/pi-auto-continue/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "auto-continue",
    "pdca",
    "okr",
    "swot",
    "tdd",
    "story-map"
  ],
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/auto-continue.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  }
}
